<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.aicalendar.mapper.AiChatMapper">

    <resultMap id="AiChatResult" type="com.aicalendar.entity.AiChat">
        <id property="id" column="id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.aicalendar.entity.AiChat">
        INSERT INTO ai_chat (conversation_id, role, content, created_at)
        VALUES (#{conversationId}, #{role}, #{content}, #{createdAt})
    </insert>

    <select id="selectByConversationId" resultMap="AiChatResult">
        SELECT * FROM ai_chat 
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at ASC
    </select>

    <select id="selectRecent" resultMap="AiChatResult">
        SELECT * FROM ai_chat 
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <delete id="deleteByConversationId">
        DELETE FROM ai_chat WHERE conversation_id = #{conversationId}
    </delete>

    <!-- 后台：会话列表，按对话ID分组聚合，支持按对话ID模糊搜索 -->
    <select id="selectConversationList" resultType="com.aicalendar.dto.response.AdminConversationResponse">
        SELECT conversation_id AS conversationId,
               COUNT(*) AS messageCount,
               MAX(created_at) AS lastTime
        FROM ai_chat
        <where>
            <if test="keyword != null and keyword != ''">
                AND conversation_id LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        GROUP BY conversation_id
        ORDER BY lastTime DESC
    </select>

    <!-- 后台：会话总数（按对话ID去重） -->
    <select id="countDistinctConversations" resultType="int">
        SELECT COUNT(DISTINCT conversation_id) FROM ai_chat
    </select>

    <!-- 后台：查询指定时间范围内的全部聊天记录（用于趋势统计） -->
    <select id="selectByTimeRange" resultMap="AiChatResult">
        SELECT * FROM ai_chat
        WHERE created_at &gt;= #{startTime} AND created_at &lt; #{endTime}
    </select>

</mapper>